# .env.example — Konfigurasi Lingkungan DiskonBot (Template)
# Salin file ini menjadi '.env' dan isi dengan kredensial Anda yang sebenarnya.

# Token Telegram Bot dari @BotFather (Wajib)
BOT_TOKEN=your_telegram_bot_token_here

# Username Channel Publik Telegram tujuan posting promo
CHANNEL_ID=@your_channel_username

# ID Telegram Admin (pisahkan koma jika lebih dari satu)
ADMIN_IDS=your_telegram_admin_id

# Password Dashboard Admin Web
ADMIN_SECRET=your_admin_secret_password

# ID Afiliasi Marketplace
AFFILIATE_SHOPEE_ID=your_shopee_affiliate_id
AFFILIATE_TOKOPEDIA_ID=your_tokopedia_affiliate_id
AFFILIATE_BLIBLI_ID=your_blibli_affiliate_id
AFFILIATE_LAZADA_ID=your_lazada_affiliate_id
AFFILIATE_TIKTOK_ID=your_tiktok_affiliate_id
